{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/projecten/badkamerrenovatie-merksem/?",
      "status": 308,
      "headers": {
        "Location": "/projecten/mortex-badkamer-merksem"
      }
    },
    {
      "src": "/badkamerrenovatie-antwerpen/?",
      "dest": "/badkamerrenovatie-antwerpen.html"
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
